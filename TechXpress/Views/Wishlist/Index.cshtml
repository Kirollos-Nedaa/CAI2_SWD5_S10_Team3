@model WishlistViewModel
@{
    ViewData["Title"] = "Wishlist";
}
<div class="max-w-6xl mx-auto p-6">
    <h2 class="text-3xl font-semibold mb-6 text-gray-800">Wishlist</h2>

    @if (!Model.Items.Any())
    {
        <p class="text-gray-500">Your wishlist is empty.</p>
    }
    else
    {
        <div class="overflow-x-auto rounded-lg shadow">
            <table class="min-w-full text-left bg-white">
                <thead class="bg-gray-100 text-gray-600 uppercase text-sm">
                    <tr>
                        <th class="px-6 py-3">Products</th>
                        <th class="px-6 py-3">Price</th>
                        <th class="px-6 py-3">Stock Status</th>
                        <th class="px-6 py-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr class="border-t border-gray-200 hover:bg-gray-50 transition">
                            <td class="px-6 py-4 flex items-center gap-4">
                                <img src="@item.ImageUrl" alt="@item.Name" class="w-16 h-16 object-contain rounded" />
                                <span class="text-gray-800 font-medium">@item.Name</span>
                            </td>
                            <td class="px-6 py-4">
                                <span class="text-gray-800 font-semibold">@item.Price.ToString("C0")</span>
                            </td>
                            <td class="px-6 py-4">
                                @if (item.Stock == 0)
                                {
                                    <span class="text-red-500 font-medium whitespace-nowrap">OUT OF STOCK</span>
                                }
                                else if (item.Stock > 0 && item.Stock <= 5)
                                {
                                    <span class="text-orange-400 font-medium whitespace-nowrap">LIMITED SUPPLY</span>
                                }
                                else
                                {
                                    <span class="text-green-500 font-medium">IN STOCK</span>
                                }
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-2">
                                    @if (item.Stock > 0)
                                    {
                                        <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <button type="submit"
                                                    class="bg-black text-white px-4 py-2 rounded hover:bg-gray-500 transition text-sm whitespace-nowrap">
                                                ADD TO CART
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button disabled
                                                class="bg-gray-300 text-white px-4 py-2 rounded text-sm cursor-not-allowed whitespace-nowrap">
                                            ADD TO CART
                                        </button>
                                    }

                                    <form asp-action="RemoveFromWishlist" method="post">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <button type="submit"
                                                class="items-center justify-center text-gray-400 hover:text-red-500 transition text-3xl leading-none">
                                            &times;
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <form asp-action="ClearWishlist" method="post" class="mt-6 text-center">
            <button type="submit"
                    class="bg-black text-white px-6 py-3 rounded-md hover:bg-gray-100 hover:text-black transition">
                Clear Wishlist
            </button>
        </form>
    }
</div>