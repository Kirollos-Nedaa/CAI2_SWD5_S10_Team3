@model VerifyCodeViewModel

@{
    ViewData["Title"] = "Email Verification";
}

<div class="max-w-md mx-auto m-12 bg-white shadow-md rounded-lg p-8">
    <h2 class="text-2xl font-bold mb-4 text-black text-center">Verify Your Email</h2>
    <p class="text-gray-700 mb-6 text-center">
        We've sent a verification code to your email address. Please enter the code below to activate your account.
        Be sure to check your spam folder if you don't see it.
    </p>

    @if (!ViewData.ModelState.IsValid)
    {
        var error = ViewData.ModelState.Values.SelectMany(v => v.Errors).FirstOrDefault();
        if (error != null)
        {
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6 text-sm" role="alert">
                @error.ErrorMessage
            </div>
        }
    }

    <div id="resendMessage" class="hidden text-sm px-4 py-3 rounded mb-4 text-center" role="alert"></div>

    @if (TempData["Message"] != null)
    {
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded text-sm text-center mb-4" role="alert">
            @TempData["Message"]
        </div>
    }

    <form asp-action="VerifyCode" asp-controller="Account" method="post" class="space-y-6">
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Code" id="Code" />
        <div class="flex justify-between gap-2 mb-4" id="code-inputs">
            @for (int i = 0; i < 6; i++)
            {
                <input type="text"
                       maxlength="1"
                       class="w-12 h-12 text-center text-lg border rounded focus:outline-none focus:ring-2 focus:ring-black"
                       oninput="handleInput(event, @i)"
                       onkeydown="handleKeyDown(event, @i)"
                       id="code-@i"
                       inputmode="numeric"
                       pattern="[0-9]*" />
            }
        </div>
        <button type="submit" class="w-full bg-black text-white py-2 px-4 rounded hover:bg-neutral-900 transition-all">
            Confirm Email
        </button>
    </form>

    <p class="mt-6 text-center text-gray-500 text-sm">
        Didn't receive the code?
        <button type="button" id="resendBtn" class="text-gray-600 hover:underline ml-1" data-user-id="@Model.UserId">
            Resend
        </button>
        <span id="countdown" class="ml-2 text-gray-400 hidden">(60s)</span>
    </p>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        const inputs = Array.from(document.querySelectorAll('#code-inputs input'));
        const hiddenInput = document.getElementById("Code");

        function updateHiddenInput() {
            hiddenInput.value = inputs.map(input => input.value).join('');
        }

        function handleInput(e, index) {
            const input = e.target;
            const value = input.value;

            if (!/^\d$/.test(value)) {
                input.value = "";
                return;
            }

            if (value.length === 1 && index < inputs.length - 1) {
                inputs[index + 1].focus();
            }

            updateHiddenInput();
        }

        function handleKeyDown(e, index) {
            const input = e.target;
            if (e.key === "Backspace" && !input.value && index > 0) {
                inputs[index - 1].focus();
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            inputs.forEach((input, index) => {
                input.addEventListener("input", (e) => handleInput(e, index));
                input.addEventListener("keydown", (e) => handleKeyDown(e, index));
            });

            updateHiddenInput();

            // === Resend Logic ===
            const resendBtn = document.getElementById("resendBtn");
            const countdown = document.getElementById("countdown");
            const resendMessage = document.getElementById("resendMessage");
            let timer = null;
            let secondsLeft = 60;

            function startCountdown() {
                resendBtn.classList.add("hidden");
                countdown.classList.remove("hidden");
                countdown.textContent = `(${secondsLeft}s)`;

                timer = setInterval(() => {
                    secondsLeft--;
                    countdown.textContent = `(${secondsLeft}s)`;
                    if (secondsLeft <= 0) {
                        clearInterval(timer);
                        resendBtn.classList.remove("hidden");
                        countdown.classList.add("hidden");
                        secondsLeft = 60;
                    }
                }, 1000);
            }

            resendBtn?.addEventListener("click", () => {
                const userId = resendBtn.dataset.userId;
                resendMessage.classList.add("hidden");
                resendMessage.textContent = "";

                startCountdown();

                fetch(`/Account/ResendVerificationCode?userId=${encodeURIComponent(userId)}`)
                    .then(response => {
                        if (response.ok) {
                            resendMessage.textContent = "A new verification code has been sent to your email.";
                            resendMessage.className = "bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded text-sm text-center mb-4";
                            resendMessage.classList.remove("hidden");
                        } else {
                            resendMessage.textContent = "Failed to resend verification code.";
                            resendMessage.className = "bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded text-sm text-center mb-4";
                            resendMessage.classList.remove("hidden");
                        }
                    })
                    .catch(error => {
                        resendMessage.textContent = "An error occurred.";
                        resendMessage.className = "bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded text-sm text-center mb-4";
                        resendMessage.classList.remove("hidden");
                    });
            });
        });
    </script>
}