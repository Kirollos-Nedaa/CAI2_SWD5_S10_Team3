@model IEnumerable<Product>
@{
    ViewData["Title"] = "Manage Products";
    Layout = "_AdminLayout";
}

<div class="px-4 sm:px-6 lg:px-8 py-6">
    <!-- Header Section -->
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-3xl font-bold text-gray-900">Manage Products</h1>
        <a asp-action="CreateProduct"
           class="inline-flex items-center px-4 py-2 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-lg shadow-sm transition duration-200 ease-in-out transform hover:scale-105">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            Add New Product
        </a>
    </div>

    <!-- Statistics Cards -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-white rounded-lg shadow-sm p-4 border border-gray-200">
            <div class="flex items-center">
                <div class="flex-shrink-0">
                    <div class="w-8 h-8 bg-blue-100 rounded-md flex items-center justify-center">
                        <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                        </svg>
                    </div>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-gray-500">Total Products</p>
                    <p class="text-2xl font-semibold text-gray-900">@Model.Count()</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow-sm p-4 border border-gray-200">
            <div class="flex items-center">
                <div class="flex-shrink-0">
                    <div class="w-8 h-8 bg-green-100 rounded-md flex items-center justify-center">
                        <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-gray-500">Active Products</p>
                    <p class="text-2xl font-semibold text-gray-900">@Model.Count()</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow-sm p-4 border border-gray-200">
            <div class="flex items-center">
                <div class="flex-shrink-0">
                    <div class="w-8 h-8 bg-yellow-100 rounded-md flex items-center justify-center">
                        <svg class="w-4 h-4 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                        </svg>
                    </div>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-gray-500">Total Value</p>
                    <p class="text-2xl font-semibold text-gray-900">@Model.Sum(p => p.Price * p.Quantity).ToString("C")</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow-sm p-4 border border-gray-200">
            <div class="flex items-center">
                <div class="flex-shrink-0">
                    <div class="w-8 h-8 bg-purple-100 rounded-md flex items-center justify-center">
                        <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                        </svg>
                    </div>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-gray-500">Categories</p>
                    <p class="text-2xl font-semibold text-gray-900">@Model.Where(p => p.Category != null).Select(p => p.Category.Name).Distinct().Count()</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Products Table -->
    <div class="bg-white shadow-md sm:rounded-lg overflow-hidden">
        <div class="relative overflow-x-auto">
            <table id="productsTable" class="w-full text-sm text-left text-gray-500">
                <thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b border-gray-200">
                    <tr>
                        <th scope="col" class="px-6 py-4 font-semibold">
                            <div class="flex items-center">
                                Image
                                <svg class="w-3 h-3 ml-1 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l4-4 4 4m0 6l-4 4-4-4"></path>
                                </svg>
                            </div>
                        </th>
                        <th scope="col" class="px-6 py-4 font-semibold">
                            <div class="flex items-center">
                                Product Name
                                <svg class="w-3 h-3 ml-1 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l4-4 4 4m0 6l-4 4-4-4"></path>
                                </svg>
                            </div>
                        </th>
                        <th scope="col" class="px-6 py-4 font-semibold">
                            <div class="flex items-center">
                                Price
                                <svg class="w-3 h-3 ml-1 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l4-4 4 4m0 6l-4 4-4-4"></path>
                                </svg>
                            </div>
                        </th>
                        <th scope="col" class="px-6 py-4 font-semibold hidden sm:table-cell">
                            Category
                        </th>
                        <th scope="col" class="px-6 py-4 font-semibold hidden md:table-cell">
                            Brand
                        </th>
                        <th scope="col" class="px-6 py-4 font-semibold hidden lg:table-cell">
                            Status
                        </th>
                        <th scope="col" class="px-6 py-4 font-semibold">
                            <span class="sr-only">Actions</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var product in Model)
                        {
                            <tr class="bg-white hover:bg-gray-50 transition-colors duration-150"
                                data-category="@(product.Category?.Name ?? "")"
                                data-brand="@(product.Brand?.Name ?? "")"
                                data-price="@product.Price">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="h-14 w-14 rounded-lg border border-gray-200 bg-gray-100 flex items-center justify-center overflow-hidden">
                                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                                        {
                                            <img src="@product.ImageUrl"
                                                 alt="@product.Name"
                                                 class="h-full w-full object-cover rounded-lg"
                                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                            <div class="h-full w-full flex items-center justify-center text-gray-400 text-xs font-medium" style="display: none;">
                                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                                </svg>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-gray-400 text-xs font-medium flex items-center justify-center">
                                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                                </svg>
                                            </div>
                                        }
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="font-medium text-gray-900">@product.Name</div>
                                    <div class="text-xs text-gray-500">ID: @product.Product_Id</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="font-semibold text-gray-900">@product.Price.ToString("C")</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap hidden sm:table-cell">
                                    @if (product.Category != null)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                            @product.Category.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-gray-400 text-xs">No category</span>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap hidden md:table-cell">
                                    @if (product.Brand != null)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                                            @product.Brand.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-gray-400 text-xs">No brand</span>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap hidden lg:table-cell">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                        <svg class="w-1.5 h-1.5 mr-1" fill="currentColor" viewBox="0 0 8 8">
                                            <circle cx="4" cy="4" r="3" />
                                        </svg>
                                        Active
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-right whitespace-nowrap">
                                    <div class="flex items-center justify-end space-x-1">
                                        <a asp-action="EditProduct" asp-route-id="@product.Product_Id"
                                           class="inline-flex items-center px-3 py-1.5 text-xs font-medium text-blue-600 hover:text-blue-800 hover:bg-blue-50 rounded-md transition-colors duration-150">
                                            <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                            </svg>
                                            Edit
                                        </a>
                                        <button type="submit"
                                                data-id="@product.Product_Id"
                                                class="inline-flex items-center px-3 py-1.5 text-xs font-medium text-red-600 hover:text-red-800 hover:bg-red-50 rounded-md transition-colors duration-150 delete-product">
                                            <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                            </svg>
                                            Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="px-6 py-12 text-center">
                                <div class="flex flex-col items-center justify-center">
                                    <svg class="w-12 h-12 text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                                    </svg>
                                    <h3 class="text-lg font-medium text-gray-900 mb-2">No products found</h3>
                                    <p class="text-gray-500 mb-4">Get started by adding your first product to the catalog.</p>
                                    <a asp-action="CreateProduct"
                                       class="inline-flex items-center px-4 py-2 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-lg shadow-sm transition">
                                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                        </svg>
                                        Add Your First Product
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let allRows = $('#productsTable tbody tr[data-category]');

            // Delete product functionality
            $('.delete-product').click(function () {
                const productId = $(this).data('id');
                const productName = $(this).closest('tr').find('td:nth-child(2) .font-medium').text();

                if (confirm(`Are you sure you want to delete "${productName}"? This action cannot be undone.`)) {
                    // Show loading state
                    $(this).prop('disabled', true).html(`
                        <svg class="animate-spin w-3 h-3 mr-1" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        Deleting...
                    `);

                    $.post('/Admin/DeleteProduct/' + productId)
                        .done(function() {
                            // Show success message
                            const toast = $(`
                                <div class="fixed top-4 right-4 bg-green-500 text-white px-6 py-3 rounded-lg shadow-lg z-50">
                                    <div class="flex items-center">
                                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                        </svg>
                                        Product deleted successfully!
                                    </div>
                                </div>
                            `);
                            $('body').append(toast);
                            setTimeout(() => {
                                toast.fadeOut(() => toast.remove());
                                location.reload();
                            }, 2000);
                        })
                        .fail(function() {
                            alert('Error deleting product. Please try again.');
                            $(this).prop('disabled', false).html(`
                                <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                </svg>
                                Delete
                            `);
                        });
                }
            });

            // Show/hide empty state
                if (visibleCount === 0 && allRows.length > 0) {
                    if ($('#noResultsRow').length === 0) {
                        $('#productsTable tbody').append(`
                            <tr id="noResultsRow">
                                <td colspan="7" class="px-6 py-12 text-center">
                                    <div class="flex flex-col items-center justify-center">
                                        <svg class="w-12 h-12 text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                        </svg>
                                        <h3 class="text-lg font-medium text-gray-900 mb-2">No products match your search</h3>
                                        <p class="text-gray-500 mb-4">Try adjusting your search terms or filters.</p>
                                        <button id="clearSearchFilters" class="inline-flex items-center px-4 py-2 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-lg shadow-sm transition">
                                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                                            </svg>
                                            Clear All Filters
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        `);

                        $('#clearSearchFilters').click(function() {
                            $('#search').val('');
                            $('#categoryFilter').val('');
                            $('#brandFilter').val('');
                            $('#priceFilter').val('');
                            filterProducts();
                        });
                    }
                } else {
                    $('#noResultsRow').remove();
                }
            }

            // Add hover effects for better interactivity
            $('tbody tr[data-category]').hover(
                function() { $(this).addClass('shadow-sm'); },
                function() { $(this).removeClass('shadow-sm'); }
            );

            // Initialize filter options based on visible products
            function updateFilterOptions() {
                const categories = new Set();
                const brands = new Set();

                allRows.each(function() {
                    const category = $(this).data('category');
                    const brand = $(this).data('brand');

                    if (category) categories.add(category);
                    if (brand) brands.add(brand);
                });

                // Update category options
                const categorySelect = $('#categoryFilter');
                const currentCategory = categorySelect.val();
                categorySelect.find('option:not(:first)').remove();
                Array.from(categories).sort().forEach(category => {
                    categorySelect.append(`<option value="${category}">${category}</option>`);
                });
                categorySelect.val(currentCategory);

                // Update brand options
                const brandSelect = $('#brandFilter');
                const currentBrand = brandSelect.val();
                brandSelect.find('option:not(:first)').remove();
                Array.from(brands).sort().forEach(brand => {
                    brandSelect.append(`<option value="${brand}">${brand}</option>`);
                });
                brandSelect.val(currentBrand);
            }

            // Quick action buttons functionality
            $('.quick-view').click(function(e) {
                e.preventDefault();
                const productId = $(this).data('id');
                // Implementation for quick view modal would go here
                console.log('Quick view for product:', productId);
            });

            // Bulk actions (future feature)
            $('#selectAll').change(function() {
                $('.product-checkbox').prop('checked', $(this).is(':checked'));
                updateBulkActions();
            });

            $('.product-checkbox').change(function() {
                updateBulkActions();
            });

            function updateBulkActions() {
                const checkedBoxes = $('.product-checkbox:checked').length;
                if (checkedBoxes > 0) {
                    $('#bulkActions').removeClass('hidden');
                    $('#bulkCount').text(checkedBoxes);
                } else {
                    $('#bulkActions').addClass('hidden');
                }
            }

            // Image error handling
            $('img').on('error', function() {
                $(this).hide();
                $(this).next('.placeholder-icon').show();
            });

            // Initialize tooltips (if using a tooltip library)
            $('[data-tooltip]').each(function() {
                $(this).attr('title', $(this).data('tooltip'));
            });

            // Real-time price formatting
            $('.price-input').on('input', function() {
                let value = $(this).val().replace(/[^0-9.]/g, '');
                if (value) {
                    $(this).val(' + parseFloat(value).toFixed(2));
                }
            });

            // Export functionality (placeholder)
            $('#exportProducts').click(function() {
                // Implementation for exporting products would go here
                alert('Export functionality will be implemented here');
            });

            // Keyboard shortcuts
            $(document).keydown(function(e) {
                // Ctrl/Cmd + F to focus search
                if ((e.ctrlKey || e.metaKey) && e.keyCode === 70) {
                    e.preventDefault();
                    $('#search').focus();
                }

                // Escape to clear search
                if (e.keyCode === 27) {
                    $('#search').val('').trigger('keyup');
                }
            });

            // Initialize the page
            updateFilterOptions();

            // Auto-refresh data every 5 minutes (optional)
            // setInterval(function() {
            //     location.reload();
            // }, 300000);
        });
    </script>
}