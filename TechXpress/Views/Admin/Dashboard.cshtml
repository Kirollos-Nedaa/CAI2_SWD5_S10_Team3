@using Microsoft.Extensions.Primitives
@model DashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
}

<h1 class="mt-4 mb-4 text-3xl font-bold text-gray-800">Admin Dashboard</h1>
<div class="w-full px-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-2 gap-6">
        <!-- Orders Chart -->
        <div class="w-full bg-white rounded-lg shadow-sm p-4 md:p-6">
            <div class="flex justify-between">
                <div>
                    <h5 class="leading-none text-3xl font-bold text-gray-900 pb-2">
                        @Model.OrderStats.TotalOrders.ToString("N0")
                    </h5>
                    <p class="text-base font-normal text-gray-500">Orders placed this period</p>
                </div>
                <div class="flex items-center px-2.5 py-0.5 text-base font-semibold text-green-500 text-center">
                    @Model.OrderStats.GrowthRate.ToString("0")%
                    <svg class="w-3 h-3 ms-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 14">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M5 13V1m0 0L1 5m4-4 4 4" />
                    </svg>
                </div>
            </div>
            <div id="orders-chart"></div>
            <div class="grid grid-cols-1 items-center border-gray-200 border-t justify-between">
                <div class="flex justify-between items-center pt-5">
                    @{
                        var currentRange = Context.Request.Query["range"].ToString();
                        var rangeLabel = currentRange switch
                        {
                            "1" => "Today",
                            "0" => "Yesterday",
                            "30" => "Last 30 days",
                            "90" => "Last 90 days",
                            _ => "Last 7 days"
                        };
                    }

                    <!-- Button -->
                    <button id="dropdownDefaultButton"
                            data-dropdown-toggle="lastDaysdropdown"
                            data-dropdown-placement="bottom"
                            class="text-sm font-medium text-gray-500 hover:text-gray-900 text-center inline-flex items-center"
                            type="button">
                        @rangeLabel
                        <svg class="w-2.5 m-2.5 ms-1.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none"
                             viewBox="0 0 10 6">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="m1 1 4 4 4-4" />
                        </svg>
                    </button>

                    <!-- Dropdown menu -->
                    <div id="lastDaysdropdown"
                         class="z-10 hidden bg-white divide-y divide-gray-100 rounded-lg shadow-sm w-44">
                        <ul class="py-2 text-sm text-gray-400" aria-labelledby="dropdownDefaultButton">
                            <li><a href="?range=1" class="block px-4 py-2 hover:bg-gray-100">Today</a></li>
                            <li><a href="?range=0" class="block px-4 py-2 hover:bg-gray-100">Yesterday</a></li>
                            <li><a href="?range=7" class="block px-4 py-2 hover:bg-gray-100">Last 7 days</a></li>
                            <li><a href="?range=30" class="block px-4 py-2 hover:bg-gray-100">Last 30 days</a></li>
                            <li><a href="?range=90" class="block px-4 py-2 hover:bg-gray-100">Last 90 days</a></li>
                        </ul>
                    </div>

                    <a href="#"
                       class="uppercase text-sm font-semibold inline-flex items-center rounded-lg text-[#6A1CF2] hover:text-[#2D066F] hover:bg-gray-100 px-3 py-2">
                        Orders Report
                        <svg class="w-2.5 h-2.5 ms-1.5 rtl:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"
                             fill="none" viewBox="0 0 6 10">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="m1 9 4-4-4-4" />
                        </svg>
                    </a>
                </div>
            </div>
        </div>

        <!-- Total Sales Chart -->
        <div class="w-full bg-white rounded-lg shadow-sm p-4 md:p-6">
            <div class="flex justify-between">
                <div>
                    <h5 class="leading-none text-3xl font-bold text-gray-900 pb-2">
                        $@Model.SalesStats.TotalSales.ToString("N2")
                    </h5>
                    <p class="text-base font-normal text-gray-500">Sales this period</p>
                </div>
                <div class="flex items-center px-2.5 py-0.5 text-base font-semibold text-green-500 text-center">
                    @Model.SalesStats.GrowthRate.ToString("0")%
                    <svg class="w-3 h-3 ms-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 14">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M5 13V1m0 0L1 5m4-4 4 4" />
                    </svg>
                </div>
            </div>

            <div id="sales-chart"></div>
            <div class="grid grid-cols-1 items-center border-gray-200 border-t justify-between">
                <div class="flex justify-between items-center pt-5">
                    <button id="salesDropdownButton"
                            data-dropdown-toggle="salesDaysDropdown"
                            data-dropdown-placement="bottom"
                            class="text-sm font-medium text-gray-500 hover:text-gray-900 text-center inline-flex items-center"
                            type="button">
                        @Model.SalesStats.RangeLabel
                        <svg class="w-2.5 m-2.5 ms-1.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none"
                             viewBox="0 0 10 6">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="m1 1 4 4 4-4" />
                        </svg>
                    </button>

                    <!-- Dropdown menu -->
                    <div id="salesDaysDropdown"
                         class="z-10 hidden bg-white divide-y divide-gray-100 rounded-lg shadow-sm w-44">
                        <ul class="py-2 text-sm text-gray-400" aria-labelledby="salesDropdownButton">
                            <li><a href="?range=1" class="block px-4 py-2 hover:bg-gray-100">Today</a></li>
                            <li><a href="?range=0" class="block px-4 py-2 hover:bg-gray-100">Yesterday</a></li>
                            <li><a href="?range=7" class="block px-4 py-2 hover:bg-gray-100">Last 7 days</a></li>
                            <li><a href="?range=30" class="block px-4 py-2 hover:bg-gray-100">Last 30 days</a></li>
                            <li><a href="?range=90" class="block px-4 py-2 hover:bg-gray-100">Last 90 days</a></li>
                        </ul>
                    </div>

                    <!-- Report Link -->
                    <a href="#"
                       class="uppercase text-sm font-semibold inline-flex items-center rounded-lg text-[#6A1CF2] hover:text-[#2D066F] hover:bg-gray-100 px-3 py-2">
                        Sales Report
                        <svg class="w-2.5 h-2.5 ms-1.5 rtl:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"
                             fill="none" viewBox="0 0 6 10">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="m1 9 4-4-4-4" />
                        </svg>
                    </a>
                </div>
            </div>
        </div>
		<!-- Trending Product Chart -->

    </div>
</div>

@section Scripts {
    <script>
        function renderAreaChart(id, dataPoints, labels, name) {
            const options = {
                chart: {
                    maxWidth: "100%",
                    type: "area",
                    fontFamily: "Inter, sans-serif",
                    dropShadow: { enabled: false },
                    toolbar: { show: false }
                },
                tooltip: {
                    enabled: true,
                    x: { show: false }
                },
                fill: {
                    type: "gradient",
                    gradient: {
                        opacityFrom: 0.55,
                        opacityTo: 0,
                        shade: "#6A1CF2",
                        gradientToColors: ["#6A1CF2"]
                    }
                },
                dataLabels: { enabled: false },
                stroke: { width: 6 },
                grid: {
                    show: false,
                    strokeDashArray: 4,
                    padding: { left: 2, right: 2, top: 0 }
                },
                series: [{
                    name: name,
                    data: dataPoints,
                    color: "#6A1CF2"
                }],
                xaxis: {
                    categories: labels,
                    labels: { show: false },
                    axisBorder: { show: false },
                    axisTicks: { show: false }
                },
                yaxis: { show: false }
            };

            const el = document.getElementById(id);
            if (el && typeof ApexCharts !== 'undefined') {
                const chart = new ApexCharts(el, options);
                chart.render();
            }
        }

        // Orders Chart
        renderAreaChart(
            "orders-chart",
        @Html.Raw(Json.Serialize(Model.OrderStats.DataPoints)),
        @Html.Raw(Json.Serialize(Model.OrderStats.Labels)),
            "Orders"
        );

        // Sales Chart
        renderAreaChart(
            "sales-chart",
        @Html.Raw(Json.Serialize(Model.SalesStats.DataPoints)),
        @Html.Raw(Json.Serialize(Model.SalesStats.Labels)),
            "Sales"
        );
    </script>
}