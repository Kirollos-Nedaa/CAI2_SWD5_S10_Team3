@model EditProductDto
@{
    ViewData["Title"] = "Edit Product";
    Layout = "_AdminLayout";
}

<div class="px-4 sm:px-6 lg:px-8 py-6">
    <!-- Header Section -->
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-3xl font-bold text-gray-900">Edit Product</h1>
        <a asp-action="Products"
           class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 transition duration-200 ease-in-out">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            Back to Products
        </a>
    </div>

    <!-- Form Card -->
    <div class="bg-white shadow-md rounded-lg overflow-hidden">
        <div class="p-6 border-b border-gray-200">
            <h2 class="text-lg font-medium text-gray-900">Product Information</h2>
        </div>

        <form asp-action="EditProduct" method="post" enctype="multipart/form-data" class="p-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Product_Id" />
            <input type="hidden" asp-for="ImageUrl" />

            <!-- Name -->
            <div class="mb-6">
                <label asp-for="Name" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="Name" class="block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" />
                <span asp-validation-for="Name" class="mt-1 text-sm text-red-600"></span>
            </div>

            <!-- Description -->
            <div class="mb-6">
                <label asp-for="Description" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <textarea asp-for="Description" rows="3" class="block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm"></textarea>
                <span asp-validation-for="Description" class="mt-1 text-sm text-red-600"></span>
            </div>

            <!-- Price & Quantity -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                <div>
                    <label asp-for="Price" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="Price" class="block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" />
                    <span asp-validation-for="Price" class="mt-1 text-sm text-red-600"></span>
                </div>
                <div>
                    <label asp-for="Quantity" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="Quantity" class="block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" />
                    <span asp-validation-for="Quantity" class="mt-1 text-sm text-red-600"></span>
                </div>
            </div>

            <!-- Image Section -->
            <div class="mb-6">
                <label class="block text-sm font-medium text-gray-700 mb-1">Current Image</label>
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="mb-4">
                        <div class="h-52 w-52 rounded-lg border border-gray-200 bg-gray-100 flex items-center justify-center overflow-hidden">
                            <img src="@Model.ImageUrl"
                                 alt="Current Product Image"
                                 class="h-full w-full object-cover rounded-lg"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                            <div class="h-full w-full flex items-center justify-center text-gray-400 text-xs font-medium" style="display: none;">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                </svg>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="mb-4 text-sm text-gray-500">No current image</div>
                }

                <label asp-for="ImageFile" class="block text-sm font-medium text-gray-700 mb-1">New Image (Optional)</label>
                <div class="mt-1 flex items-center">
                    <input asp-for="ImageFile" type="file" class="hidden" accept="image/*" id="fileInput" />
                    <label for="fileInput" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 cursor-pointer">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                        Choose File
                    </label>
                    <span id="fileName" class="ml-2 text-sm text-gray-500">No file chosen</span>
                </div>
                <span asp-validation-for="ImageFile" class="mt-1 text-sm text-red-600"></span>
            </div>

            <!-- Category & Brand -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                <div>
                    <label asp-for="Category_Id" class="block text-sm font-medium text-gray-700 mb-1">Category</label>
                    <select asp-for="Category_Id" asp-items="ViewBag.Categories"
                            class="block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
                        <option value="">Select Category</option>
                    </select>
                    <span asp-validation-for="Category_Id" class="mt-1 text-sm text-red-600"></span>
                </div>
                <div>
                    <label asp-for="Brand_Id" class="block text-sm font-medium text-gray-700 mb-1">Brand</label>
                    <select asp-for="Brand_Id" asp-items="ViewBag.Brands"
                            class="block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
                        <option value="">Select Brand</option>
                    </select>
                    <span asp-validation-for="Brand_Id" class="mt-1 text-sm text-red-600"></span>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="flex items-center justify-end space-x-3 pt-6 border-t border-gray-200">
                <a asp-action="Products" class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 transition duration-200 ease-in-out">
                    Cancel
                </a>
                <button type="submit" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition duration-200 ease-in-out">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"></path>
                    </svg>
                    Update Product
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            // Update filename display when file is selected
            $('#fileInput').change(function() {
                const fileName = $(this).val().split('\\').pop();
                $('#fileName').text(fileName || 'No file chosen');

                // Client-side validation
                if (this.files && this.files[0]) {
                    const file = this.files[0];
                    const validTypes = ['image/jpeg', 'image/png', 'image/gif'];
                    const maxSize = 5 * 1024 * 1024; // 5MB

                    if (!validTypes.includes(file.type)) {
                        alert('Only JPEG, PNG, or GIF images are allowed.');
                        $(this).val('');
                        $('#fileName').text('No file chosen');
                    }

                    if (file.size > maxSize) {
                        alert('Image must be smaller than 5MB.');
                        $(this).val('');
                        $('#fileName').text('No file chosen');
                    }
                }
            });

            // Add hover effects for better interactivity
            $('button, a').hover(
                function() { $(this).addClass('transition-colors duration-150'); },
                function() { $(this).removeClass('transition-colors duration-150'); }
            );
        });
    </script>
}